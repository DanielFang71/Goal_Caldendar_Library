{
  "name": "goalcalendar",
  "version": "1.0.1",
  "description": "Goal Calendar JS library (CSC309 project) with water-filling animation",
  "license": "ISC",
  "author": "Ruikai Fang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielFang71/Goal_Caldendar_Library.git"
  },
  "bugs": {
    "url": "https://github.com/DanielFang71/Goal_Caldendar_Library/issues"
  },
  "homepage": "https://github.com/DanielFang71/Goal_Caldendar_Library#readme",
  "keywords": [
    "calendar",
    "goal",
    "animation",
    "water",
    "js",
    "library"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./modern.css": "./dist/modern.css"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "demo": "node server.js",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier -w .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "express": "^4.17.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
